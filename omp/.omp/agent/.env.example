# Copy to ~/.omp/agent/.env (mode 600). omp loads it before any provider lookup.
# A variable already exported in your shell always wins over this file.

# Workhorse — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic Console key (NOT a Claude Max login — see README "Auth").
ANTHROPIC_API_KEY=

# Google AI Studio key for the `google` provider (Gemini API).
GEMINI_API_KEY=

# TypeSafe Jev — powers providers.judgmentProvider. Or run `/login typesafe`.
TYPESAFE_API_KEY=

# OpenAI Codex: no key. Run `/login openai-codex` (ChatGPT OAuth) inside omp.

# Optional web_search backends
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
