# vim: set filetype=sh:

# Env Vars --------------------------------------------------------------------
export PRIVATE="$HOME/Library/CloudStorage/Dropbox/private"
if [ -d /opt/homebrew/bin ]; then
    export PATH="/opt/homebrew/bin:$PATH"
elif [ -d /usr/local/bin ]; then
    export PATH="/usr/local/bin:$PATH"
fi

alias cddnd="cd $PRIVATE/Dungeons & Dragons"
